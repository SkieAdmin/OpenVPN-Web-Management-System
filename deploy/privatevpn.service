[Unit]
Description=PrivateVPN web panel (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=privatevpn
Group=privatevpn
# gunicorn serves the panel directly, so this is the address browsers connect
# to. deploy/install.sh writes the real value into the env file below.
Environment=PRIVATEVPN_BIND=0.0.0.0:8905
EnvironmentFile=/etc/privatevpn.env
WorkingDirectory=/opt/privatevpn
ExecStart=/opt/privatevpn/.venv/bin/gunicorn privatevpn.wsgi:application \
    --bind $PRIVATEVPN_BIND --workers 2 --timeout 90 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=3
PrivateTmp=true
# NoNewPrivileges/ProtectSystem are left off on purpose: the app needs sudo
# to run /usr/local/sbin/privatevpn-helper, which writes /etc/wireguard.

[Install]
WantedBy=multi-user.target
